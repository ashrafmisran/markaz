<?php

namespace App\Filament\Pages\Auth;

use Filament\Forms;
use Filament\Forms\Form;
use Filament\Pages\Auth\Register as BaseRegister;
use Illuminate\Database\Eloquent\Model;
use Filament\Forms\Components\TextInput;

class Register extends BaseRegister
{
    // add the extra field into the form
    public function form(Form $form): Form
    {
        return $form
            ->schema([
                $this->getNameFormComponent(),                // default name
                $this->getEmailFormComponent(),               // default email
                TextInput::make('mykad')          // new mykad field
                    ->label('MyKad')
                    ->required()
                    ->maxLength(12)
                    ->unique(table: 'users', column: 'mykad', ignoreRecord: true)
                    ->helperText('Enter your MyKad number without dashes.'),
                $this->getPasswordFormComponent(),            // default password
                $this->getPasswordConfirmationFormComponent(),
            ]);
    }

    // handle saving — keep Filament's flow but include extra data
    protected function handleRegistration(array $data): Model
    {
        // ensure your users table has a 'branch' column
        $user = $this->getUserModel()::create([
            'name' => $data['name'],
            'email' => $data['email'],
            'password' => bcrypt($data['password']),
            'mykad' => $data['mykad'],
        ]);

        // you can do extra steps here (assign role, events, etc.)
        return $user;
    }
}
